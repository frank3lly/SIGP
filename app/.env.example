# ==============================================================================
# PARQUEAME WEB CLIENT - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Backend REST API Base URL
# Development: http://localhost:8000
# Production Cloud: https://thegxnster-parqueame-server.hf.space
VITE_API_BASE_URL=http://localhost:8000

# Client Polling Interval in milliseconds (default: 3000ms)
VITE_POLLING_INTERVAL_MS=3000

# Client Request Timeout in milliseconds (default: 3000ms)
VITE_REQUEST_TIMEOUT_MS=3000

# Default Establishment / Venue Identifier (Stage 700 standard)
VITE_DEFAULT_ESTABLISHMENT_ID=uce_central
