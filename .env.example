# ==============================================================================
# PARQUEAME CENTRAL SERVER - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# Neon Serverless PostgreSQL (Pooled Connection String Template)
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Panel Admin Credentials
PARQUEAME_ADMIN_USER=admin
PARQUEAME_ADMIN_PASSWORD=your_secure_admin_password_here

# Detection Mode (false = live hardware ingestion, true = test samples replay)
PARQUEAME_TEST_MODE=false

# Console output streaming
PYTHONUNBUFFERED=1

# Server port
PORT=8000
